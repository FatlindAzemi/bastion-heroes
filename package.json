{
  "name": "bastion-heroes",
  "version": "0.1.0",
  "private": true,
  "description": "Bastion Heroes - a single-player mobile lane-defense game.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate-data": "tsx tools/validate-data.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate-data"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "11.0.2",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
