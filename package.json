{
  "name": "bastion-heroes",
  "version": "0.1.0",
  "private": true,
  "description": "Bastion Heroes - a single-player mobile lane-defense game.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "validate-data": "tsx tools/validate-data.ts",
    "balance": "tsx tools/balance-sim/run.ts",
    "assets": "tsx tools/build-assets/run.ts",
    "assets:check": "tsx tools/build-assets/check.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run validate-data",
    "textures:particles": "tsx tools/particles-texture.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "howler": "2.2.4",
    "preact": "11.0.2",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@types/howler": "2.2.13",
    "@types/three": "0.186.0",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
